    "@profusion/apollo-federation-upload": "4.2.0",
    "@sentry/node": "7.120.4",
    "@sentry/tracing": "7.120.4",
    "aws-xray-sdk-core": "3.3.8",
    "aws-xray-sdk-express": "3.3.8",
    "cors": "2.8.5",
    "deep-equal-in-any-order": "2.0.6",
    "express": "4.22.3",
    "graphql": "16.11.0",
